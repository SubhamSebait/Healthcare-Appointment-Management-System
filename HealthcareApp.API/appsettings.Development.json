{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HealthcareDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "HealthcareApp_SuperSecret_JWT_Key_2024_College_Project",
